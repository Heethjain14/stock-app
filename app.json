{
  "expo": {
    "name": "StockApp",
    "slug": "stock-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "stockapp",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.stockapp.prototype",
      "supportsTablet": false
    },
    "android": {
      "package": "com.stockapp.prototype",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#0f172a"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "StockApp",
      "backgroundColor": "#0f172a"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow StockApp to use the camera to scan item QR codes."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow StockApp to save QR codes to your photos.",
          "savePhotosPermission": "Allow StockApp to save QR codes to your photos.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0f172a"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
